# Telegram
BOT_TOKEN=
OWNER_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional. Send Telegram uploads to this channel and keep the bot PM clean.
# Use a numeric ID like -1001234567890 or a resolvable username like @my_channel.
# The bot must be an admin/member with permission to post.
TELEGRAM_DUMP_CHAT_ID=

# Cloudflare R2
# Keep the bucket private. Links remain usable until automatic object deletion.
R2_ENDPOINT_URL=
R2_BUCKET=mirror-bot
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=uploads/
R2_AUTO_DELETE_SECONDS=172800
# Optional read-only account usage shown by /r2stats.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Tasks
TASK_LIMIT=10

# Status
STATUS_UPDATE_INTERVAL=10

# Temporary tokenized pages
# Torrent selector opens on TORRENT_SELECTION_PORT.
# Public links auto-detect the VPS IP. Optional emergency override: PUBLIC_BASE_URL=http://your-server-ip
TORRENT_SELECTION_PORT=8001
TORRENT_SELECTION_TIMEOUT=300
TZ=Asia/Kolkata

# Advanced tuning (all optional; defaults shown)
# LOG_FILE=logs/bot.log
# DISK_MIN_RESERVE_BYTES=5368709120     # keep at least this many bytes free
# DISK_RESERVE_RATIO=0.05               # ...or this fraction of the disk, whichever is larger
# STALL_TIMEOUT_SECONDS=600             # fail a transfer with no progress for this long
# GUARD_CHECK_INTERVAL_SECONDS=5        # how often the disk/stall watchdog polls
# TORRENT_METADATA_TIMEOUT=300          # seconds to wait for torrent metadata
# TORRENT_ADD_TIMEOUT=60                # seconds to wait for qBittorrent to register a torrent
